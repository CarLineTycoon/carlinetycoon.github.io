          "passive_slot_planner_3",
          "passive_unload_table_1",
          "passive_unload_table_2",
          "passive_unload_table_3",
          "passive_supply_office_1",
          "passive_supply_office_2",
          "passive_supply_office_3",
          "passive_reserve_planner_1",
          "passive_reserve_planner_2",
          "passive_reserve_planner_3",
          "passive_route_board_1",
          "passive_route_board_2",
          "passive_route_board_3",
          "passive_buffer_control_1",
          "passive_buffer_control_2",
          "passive_buffer_control_3",
          "passive_transformer_1",
          "passive_transformer_2",
          "passive_transformer_3",
          "passive_flywheel_1",
          "passive_flywheel_2",
          "passive_flywheel_3",
          "passive_switchboard_1",
          "passive_switchboard_2",
          "passive_switchboard_3",
          "passive_grid_control_1",
          "passive_grid_control_2",
          "passive_grid_control_3",
          "passive_dormitory_1",
          "passive_dormitory_2",
          "passive_dormitory_3",
          "passive_classroom_1",
          "passive_classroom_2",
          "passive_classroom_3",
          "passive_lockers_1",
          "passive_lockers_2",
          "passive_lockers_3",
          "passive_recreation_1",
          "passive_recreation_2",
          "passive_recreation_3",
          "passive_drawing_room_1",
          "passive_drawing_room_2",
          "passive_drawing_room_3",
          "passive_patent_archive_1",
          "passive_patent_archive_2",
          "passive_patent_archive_3",
          "passive_pilot_lab_1",
          "passive_pilot_lab_2",
          "passive_pilot_lab_3",
          "passive_innovation_office_1",
          "passive_innovation_office_2",
          "passive_innovation_office_3"
        ]
      },
      "maxItems": 40
    },
    "rule": {
      "description": "One special rule, or an empty text for none.",
      "type": "string",
      "enum": [
        "",
        "daily_fleet_orders"
      ]
    },
    "texts": {
      "description": "The title and description per language. A mod's scenario needs at least one.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lang": {
            "description": "The two-letter language code (\"en\", \"it\", ...). English is the fallback.",
            "type": "string",
            "minLength": 1
          },
          "title": {
            "description": "The scenario's title.",
            "type": "string",
            "minLength": 1
          },
          "description": {
            "description": "The scenario's description.",
            "type": "string"
          }
        },
        "required": [
          "lang",
          "title"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "readyLines",
    "objectives",
    "texts"
  ]
}
