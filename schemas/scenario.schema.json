{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlinetycoon.github.io/schemas/scenario.schema.json",
  "title": "Car Line Tycoon scenario (.clt-scenario.json)",
  "description": "A Free play scenario: the starting money, the ready factory, the goals, and optionally a story chapter, research already done and one special rule.",
  "type": "object",
  "properties": {
    "format": {
      "description": "The kind of file. Always this value.",
      "const": "car-line-tycoon.scenario"
    },
    "formatVersion": {
      "description": "The version of the format. The game reads version 1 and refuses a newer one.",
      "type": "integer",
      "const": 1
    },
    "gameVersion": {
      "description": "The game version that wrote the file. Informative only.",
      "type": "string"
    },
    "id": {
      "description": "The scenario's id. In the game it becomes modId.id.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,40}$"
    },
    "startingFundsCents": {
      "description": "The starting money in cents. 0 means the standard money of Free play for the chosen difficulty.",
      "type": "integer",
      "minimum": 0
    },
    "readyLines": {
      "description": "Assembly lines in the ready factory.",
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "readyShowroom": {
      "description": "Whether the game starts with a ready showroom.",
      "type": "boolean"
    },
    "objectives": {
      "description": "The goals, from the game's list of Free play objectives.",
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "description": "An objective id.",
        "type": "string",
        "enum": [
          "sales_100",
          "sales_500",
          "reputation_60",
          "reputation_90",
          "funds_1m",
          "share_family_25",
          "share_any_40",
          "leader_any",
          "contracts_settled_10",
          "war_commissions_3",
          "no_loan_60",
          "models_10_gen3"
        ]
      }
    },
    "startChapter": {
      "description": "A story chapter published on day one, or an empty text for none. An unknown chapter stops the game from starting.",
      "type": "string",
      "enum": [
        "",
        "tensions",
        "war",
        "ultimatum",
        "strike",
        "rebuild",
        "legacy"
      ]
    },
    "completedResearch": {
      "description": "Research topics done from the start, with the topics they need. Unknown ids are ignored.",
      "type": "array",
      "items": {
        "description": "A research topic id.",
        "type": "string",
        "enum": [
          "precision",
          "automation",
          "parallel",
          "military",
          "comfort",
          "future",
          "hybrid",
          "process_1",
          "process_2",
          "process_3",
          "process_4",
          "process_5",
          "process_6",
          "process_7",
          "process_8",
          "process_9",
          "process_10",
          "quality_1",
          "quality_2",
          "quality_3",
          "quality_4",
          "quality_5",
          "quality_6",
          "quality_7",
          "quality_8",
          "quality_9",
          "quality_10",
          "logistics_1",
          "logistics_2",
          "logistics_3",
          "logistics_4",
          "logistics_5",
          "logistics_6",
          "logistics_7",
          "logistics_8",
          "logistics_9",
          "logistics_10",
          "energy_1",
          "energy_2",
          "energy_3",
          "energy_4",
          "energy_5",
          "energy_6",
          "energy_7",
          "energy_8",
          "energy_9",
          "energy_10",
          "people_1",
          "people_2",
          "people_3",
          "people_4",
          "people_5",
          "people_6",
          "people_7",
          "people_8",
          "people_9",
          "people_10",
          "science_1",
          "science_2",
          "science_3",
          "science_4",
          "science_5",
          "science_6",
          "science_7",
          "science_8",
          "science_9",
          "science_10",
          "special_1",
          "special_2",
          "special_3",
          "special_4",
          "special_5",
          "special_6",
          "special_7",
          "special_8",
          "special_9",
          "special_10",
          "design5",
          "bodywork5",
          "military_2",
          "military_3",
          "car_family_1",
          "car_family_2",
          "car_family_3",
          "car_compact_1",
          "car_compact_2",
          "car_compact_3",
          "car_work_1",
          "car_work_2",
          "car_work_3",
          "car_sport_1",
          "car_sport_2",
          "car_sport_3",
          "car_luxury_1",
          "car_luxury_2",
          "car_luxury_3",
          "car_heavy_1",
          "car_heavy_2",
          "car_heavy_3",
          "part_front_1",
          "part_front_2",
          "part_front_3",
          "part_chassis_1",
          "part_chassis_2",
          "part_chassis_3",
          "part_wheels_1",
          "part_wheels_2",
          "part_wheels_3",
          "part_fenders_1",
          "part_fenders_2",
          "part_fenders_3",
          "part_exhaust_1",
          "part_exhaust_2",
          "part_exhaust_3",
          "part_roof_1",
