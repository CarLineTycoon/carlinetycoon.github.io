{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlinetycoon.github.io/schemas/layout.schema.json",
  "title": "Car Line Tycoon layout (.clt-layout.json)",
  "description": "The layout of one floor of one site: walls, areas and objects. Importing it builds each piece at its normal price under the game's normal rules.",
  "type": "object",
  "properties": {
    "format": {
      "description": "The kind of file. Always this value.",
      "const": "car-line-tycoon.layout"
    },
    "formatVersion": {
      "description": "The version of the format. The game reads version 1 and refuses a newer one.",
      "type": "integer",
      "const": 1
    },
    "gameVersion": {
      "description": "The game version that wrote the file. Informative only.",
      "type": "string"
    },
    "id": {
      "description": "The file's id.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,40}$"
    },
    "name": {
      "description": "The layout's name.",
      "type": "string"
    },
    "site": {
      "description": "The site the layout belongs to.",
      "type": "string",
      "enum": [
        "industrial",
        "urban"
      ]
    },
    "floor": {
      "description": "The floor, 0 for the ground floor.",
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "objects": {
      "description": "The objects, placed after the walls and the areas.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "definition": {
            "description": "The object's id in the game's catalogue.",
            "type": "string",
            "enum": [
              "aftersales_desk",
              "alignment_1",
              "alignment_2",
              "alignment_3",
              "armament",
              "armor",
              "armor_jigs_1",
              "armor_jigs_2",
              "armor_jigs_3",
              "batch_control_1",
              "batch_control_2",
              "batch_control_3",
              "battery_bank_1",
              "battery_bank_2",
              "battery_bank_3",
              "belt",
              "body",
              "body_mold_1",
              "body_mold_2",
              "body_mold_3",
              "buffer",
              "calibration_1",
              "calibration_2",
              "calibration_3",
              "canteen_1",
              "canteen_2",
              "canteen_3",
              "coffee_counter",
              "coffee_table",
              "collector_1",
              "collector_2",
              "collector_3",
              "customer_service",
              "diesel_plant_1",
              "diesel_plant_2",
              "diesel_plant_3",
              "display_bay",
              "dyno_1",
              "dyno_2",
              "dyno_3",
              "electronics_lab_1",
              "electronics_lab_2",
              "electronics_lab_3",
              "engine",
              "exit",
              "finance_office",
              "finishing_1",
              "finishing_2",
              "finishing_3",
              "flight",
              "floor_lamp",
              "forklift_1",
              "forklift_2",
              "forklift_3",
              "foundry",
              "frame",
              "generator",
              "handling_service",
              "handover_bay",
              "hybrid_interface_1",
              "hybrid_interface_2",
              "hybrid_interface_3",
              "kids_corner",
              "lab",
              "light_booth_1",
              "light_booth_2",
              "light_booth_3",
              "line_balancer_1",
              "line_balancer_2",
              "line_balancer_3",
              "lounge",
              "machine_shop",
              "metallurgy_lab_1",
              "metallurgy_lab_2",
              "metallurgy_lab_3",
              "metrology_1",
              "metrology_2",
              "metrology_3",
              "mix_station_1",
              "mix_station_2",
              "mix_station_3",
              "navigation_test_1",
              "navigation_test_2",
              "navigation_test_3",
              "paint",
              "press_bench_1",
              "press_bench_2",
              "press_bench_3",
              "qa",
              "quality_office_1",
              "quality_office_2",
              "quality_office_3",
              "rack",
              "receiving_bay",
              "reception_desk",
              "rework_bay",
              "rubber_press",
              "scrap_bay",
              "service_desk",
              "servo_test_1",
              "servo_test_2",
              "servo_test_3",
              "shield_station_1",
              "shield_station_2",
              "shield_station_3",
              "shift_office_1",
              "shift_office_2",
              "shift_office_3",
              "showroom_plant",
              "showroom_rug",
              "simulation_lab_1",
              "simulation_lab_2",
              "simulation_lab_3",
              "solar",
              "split",
              "staff_canteen",
              "standards_office_1",
              "standards_office_2",
              "standards_office_3",
              "test_drive_desk",
              "test_station_1",
              "test_station_2",
              "test_station_3",
              "thruster_test_1",
              "thruster_test_2",
              "thruster_test_3",
              "tool_bank_1",
              "tool_bank_2",
              "tool_bank_3",
              "trace_office_1",
              "trace_office_2",
              "trace_office_3",
              "turbine_1",
              "turbine_2",
              "turbine_3",
              "turn",
              "turn_left",
              "ups",
              "vending_machine",
              "waiting_armchair",
              "waiting_armchair_deluxe",
              "waiting_bench",
              "waiting_radio",
              "waiting_sofa",
              "waiting_sofa_deluxe",
              "wall_clock",
              "washrooms_1",
              "washrooms_2",
              "washrooms_3",
              "water_cooler",
              "weapon_test_1",
              "weapon_test_2",
              "weapon_test_3",
              "weld_cell_1",
              "weld_cell_2",
              "weld_cell_3",
              "wiring",
              "yard_slot"
            ]
          },
          "x": {
            "description": "The cell on the x axis.",
            "type": "integer"
          },
          "z": {
            "description": "The cell on the z axis.",
            "type": "integer"
          },
          "fineX": {
            "description": "Free furniture only: the offset inside the cell in 1/16 of a cell.",
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "fineZ": {
            "description": "Free furniture only: the offset inside the cell in 1/16 of a cell.",
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "rotation": {
            "description": "The object's facing.",
            "type": "string",
            "enum": [
              "North",
              "East",
              "South",
              "West"
            ]
          }
        },
        "required": [
          "definition",
          "x",
          "z",
          "rotation"
        ]
      },
      "maxItems": 5000
    },
    "walls": {
      "description": "The walls, from one grid point to another. Walls that close a rectangle around all the others are built as one building.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x1": {
            "description": "Start point, x.",
            "type": "integer"
          },
          "z1": {
            "description": "Start point, z.",
            "type": "integer"
          },
          "x2": {
            "description": "End point, x.",
            "type": "integer"
          },
          "z2": {
            "description": "End point, z.",
            "type": "integer"
          }
        },
        "required": [
          "x1",
          "z1",
          "x2",
          "z2"
        ]
      },
      "maxItems": 5000
    },
    "areas": {
      "description": "The areas, painted after the walls.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "description": "The area's kind.",
            "type": "string",
            "enum": [
              "Production",
              "Warehouse",
              "Services",
              "Yard",
              "Commercial",
              "Workshop"
            ]
          },
          "x": {
            "description": "The first cell on the x axis.",
            "type": "integer"
          },
          "z": {
            "description": "The first cell on the z axis.",
            "type": "integer"
          },
          "width": {
            "description": "The width in cells.",
            "type": "integer",
            "minimum": 1
          },
          "depth": {
            "description": "The depth in cells.",
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "kind",
          "x",
          "z",
          "width",
          "depth"
        ]
      },
      "maxItems": 5000
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "site",
    "objects",
    "walls",
    "areas"
  ]
}
